datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Organization {
  id                String    @id @default(uuid())
  name              String
  plan              String    @default("FREE")
  geofence_radius_m Float     @default(50.0)
  work_start        String    @default("09:00") // HH:mm
  work_end          String    @default("17:00") // HH:mm
  users             User[]
  shifts            Shift[]
  projects          Project[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

enum Role {
  EMPLOYEE
  MANAGER
  ADMIN
}

model User {
  id                String            @id @default(uuid())
  org_id            String
  name              String
  email             String            @unique
  password_hash     String
  role              Role              @default(EMPLOYEE)
  department        String?
  employee_id       String?
  join_date         String?
  profile_photo_url String?
  biometric_data    String?
  created_at        DateTime          @default(now())
  organization      Organization      @relation(fields: [org_id], references: [id], onDelete: Cascade)
  shiftAssignments  ShiftAssignment[]
  attendances       Attendance[]
  leaveRequests     LeaveRequest[]    @relation("UserLeaveRequests")
  approvedLeaves    LeaveRequest[]    @relation("ApprovedLeaveRequests")
  auditLogs         AuditLog[]

  @@index([org_id])
}

model Shift {
  id               String            @id @default(uuid())
  org_id           String
  name             String
  start_time       String // HH:mm
  end_time         String // HH:mm
  organization     Organization      @relation(fields: [org_id], references: [id], onDelete: Cascade)
  shiftAssignments ShiftAssignment[]

  @@index([org_id])
}

model ShiftAssignment {
  id       String   @id @default(uuid())
  shift_id String
  user_id  String
  date     DateTime @db.Date
  shift    Shift    @relation(fields: [shift_id], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([shift_id])
  @@index([date])
}

model Attendance {
  id                 String      @id @default(uuid())
  user_id            String
  clock_in_at        DateTime
  clock_out_at       DateTime?
  clock_in_lat       Float?
  clock_in_lng       Float?
  clock_out_lat      Float?
  clock_out_lng      Float?
  selfie_url         String?
  is_within_geofence Boolean     @default(true)
  notes              String?
  user               User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  timeEntries        TimeEntry[]
  timeBreaks         TimeBreak[]

  @@index([user_id])
  @@index([clock_in_at])
}

model TimeBreak {
  id            String     @id @default(uuid())
  attendance_id String
  start_at      DateTime   @default(now())
  end_at        DateTime?
  attendance    Attendance @relation(fields: [attendance_id], references: [id], onDelete: Cascade)

  @@index([attendance_id])
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model LeaveRequest {
  id          String      @id @default(uuid())
  user_id     String
  type        String
  start_date  DateTime    @db.Date
  end_date    DateTime    @db.Date
  status      LeaveStatus @default(PENDING)
  approved_by String?
  created_at  DateTime    @default(now())
  user        User        @relation("UserLeaveRequests", fields: [user_id], references: [id], onDelete: Cascade)
  approver    User?       @relation("ApprovedLeaveRequests", fields: [approved_by], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([start_date, end_date])
}

model Project {
  id           String       @id @default(uuid())
  org_id       String
  name         String
  client_name  String?
  organization Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  timeEntries  TimeEntry[]

  @@index([org_id])
}

model TimeEntry {
  id            String     @id @default(uuid())
  attendance_id String
  project_id    String
  hours         Float
  description   String?
  attendance    Attendance @relation(fields: [attendance_id], references: [id], onDelete: Cascade)
  project       Project    @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([attendance_id])
  @@index([project_id])
}

model AuditLog {
  id         String   @id @default(uuid())
  user_id    String
  action     String
  entity     String
  entity_id  String
  old_value  String?
  new_value  String?
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}
